-- Seeded from dev-tools @ {{DEV_TOOLS_SHA}}; this file is now the project's own.
--
-- NEW TABLE: revoke first, grant the subset, enable RLS, owner-scoped policies,
-- then verify inside the same transaction.
--
-- Worked example: public.orders, one row per order, owned by user_id. Rename
-- `orders`, its columns and its policy names throughout; keep the steps in order.
-- Apply as ONE paste in the dashboard SQL editor. Any failed check in the final
-- DO block raises, and the raise rolls the whole paste back.
--
-- Why each step: supabase-hardening skill, reference/born-open-defaults.md,
-- reference/gates-that-lie.md and reference/verification.md.

begin;

-- 1. The table. A user-owned table cascades from auth.users.
create table public.orders (
  id         uuid primary key default gen_random_uuid(),
  user_id    uuid not null references auth.users (id) on delete cascade,
  title      text not null check (char_length(title) between 1 and 200),
  note       text check (char_length(note) <= 2000),
  status     text not null default 'draft'
               check (status in ('draft', 'submitted', 'paid', 'cancelled')),  -- server-owned
  paid_at    timestamptz,                                                     -- server-owned
  created_at timestamptz not null default now()
);

-- 2. Revoke FIRST. Default privileges have already granted ALL to anon and
--    authenticated; a grant without this revoke changes nothing.
revoke all on table public.orders from public, anon, authenticated;

-- 3. THEN the intended subset. anon gets nothing: it never writes, and it may
--    hold SELECT only on data read before login, which this is not.
grant select, insert, update, delete on table public.orders to authenticated;
grant select, insert, update, delete on table public.orders to service_role;

-- 4. RLS, with one owner-scoped policy per operation.
alter table public.orders enable row level security;

create policy "orders_select_own" on public.orders
  for select to authenticated
  using (auth.uid() = user_id);

create policy "orders_insert_own" on public.orders
  for insert to authenticated
  with check (auth.uid() = user_id);

create policy "orders_update_own" on public.orders
  for update to authenticated
  using (auth.uid() = user_id)
  with check (auth.uid() = user_id);

create policy "orders_delete_own" on public.orders
  for delete to authenticated
  using (auth.uid() = user_id);

-- 5. OPTIONAL: column-level write allowlist. RLS admits the owner to the whole
--    row, so without this the client can write `status` and `paid_at` on its own
--    orders. To use it: uncomment, list exactly the columns the client writes
--    (enumerate every client insert and update site), and set
--    v_column_allowlist := true in step 6. A column added later is then born
--    server-only, and one ungranted column rejects a whole statement.
-- revoke insert, update on table public.orders from authenticated;
-- grant insert (user_id, title, note) on table public.orders to authenticated;
-- grant update (title, note) on table public.orders to authenticated;

-- 6. Verify, in the same transaction. Raw ACL first, privilege helpers second.
--    A NULL relacl means the built-in defaults apply, and aclexplode(NULL)
--    returns no rows, which would read as a pass; COALESCE with acldefault
--    expands it instead.
do $$
declare
  v_tbl              constant regclass := 'public.orders'::regclass;
  v_column_allowlist constant boolean  := false;  -- true when step 5 is uncommented
  v_acl              aclitem[];
  v_n                integer;
begin
  select coalesce(c.relacl, acldefault('r', c.relowner)) into v_acl
  from pg_class c where c.oid = v_tbl;

  -- (a) anon and PUBLIC hold nothing, at the table level or on any column.
  if exists (
    select 1 from aclexplode(v_acl) a
    where a.grantee in (0, 'anon'::regrole::oid)
  ) then
    raise exception 'VERIFY: anon or PUBLIC holds a table privilege on % (%)', v_tbl, v_acl;
  end if;
  if exists (
    select 1 from pg_attribute att, aclexplode(att.attacl) a
    where att.attrelid = v_tbl and att.attnum > 0 and not att.attisdropped
      and a.grantee in (0, 'anon'::regrole::oid)
  ) then
    raise exception 'VERIFY: anon or PUBLIC holds a column privilege on %', v_tbl;
  end if;
  if has_table_privilege('anon', v_tbl, 'SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER')
     or has_any_column_privilege('anon', v_tbl, 'SELECT, INSERT, UPDATE, REFERENCES') then
    raise exception 'VERIFY: anon effectively holds a privilege on %', v_tbl;
  end if;

  -- (b) authenticated holds the subset and nothing else: the revoke ran.
  select count(*) into v_n
  from aclexplode(v_acl) a
  where a.grantee = 'authenticated'::regrole::oid
    and a.privilege_type not in ('SELECT', 'INSERT', 'UPDATE', 'DELETE');
  if v_n > 0 then
    raise exception 'VERIFY: authenticated still holds default privileges beyond the subset on % (%)', v_tbl, v_acl;
  end if;
  if not has_table_privilege('authenticated', v_tbl, 'SELECT')
     or not has_table_privilege('authenticated', v_tbl, 'DELETE') then
    raise exception 'VERIFY: authenticated is missing SELECT or DELETE on %', v_tbl;
  end if;

  -- (c) RLS is on, with exactly one policy per operation, all for authenticated.
  if not (select c.relrowsecurity from pg_class c where c.oid = v_tbl) then
    raise exception 'VERIFY: RLS is not enabled on %', v_tbl;
  end if;
  select count(*) into v_n from pg_policy p where p.polrelid = v_tbl;
  if v_n <> 4 then
    raise exception 'VERIFY: expected 4 policies on %, found %', v_tbl, v_n;
  end if;
  if (select array_agg(p.polcmd::text order by p.polcmd::text collate "C")
      from pg_policy p where p.polrelid = v_tbl)
     is distinct from array['a', 'd', 'r', 'w'] then
    raise exception 'VERIFY: the policies on % do not cover select, insert, update and delete once each', v_tbl;
  end if;
  if exists (
    select 1 from pg_policy p
    where p.polrelid = v_tbl
      and p.polroles is distinct from array['authenticated'::regrole::oid]
  ) then
    raise exception 'VERIFY: a policy on % applies to a role other than authenticated', v_tbl;
  end if;

  -- (d) Writes: table-level grants, or the column allowlist and nothing wider.
  if v_column_allowlist then
    if exists (
      select 1 from aclexplode(v_acl) a
      where a.grantee = 'authenticated'::regrole::oid
        and a.privilege_type in ('INSERT', 'UPDATE')
    ) then
      raise exception 'VERIFY: table-level INSERT or UPDATE survived on %, so the column allowlist is moot', v_tbl;
    end if;
    if has_column_privilege('authenticated', v_tbl, 'status', 'INSERT')
       or has_column_privilege('authenticated', v_tbl, 'status', 'UPDATE')
       or has_column_privilege('authenticated', v_tbl, 'paid_at', 'INSERT')
       or has_column_privilege('authenticated', v_tbl, 'paid_at', 'UPDATE') then
      raise exception 'VERIFY: a server-owned column on % is client-writable', v_tbl;
    end if;
    if not has_column_privilege('authenticated', v_tbl, 'title', 'UPDATE') then
      raise exception 'VERIFY: an allowlisted column on % is not client-writable', v_tbl;
    end if;
  else
    if not has_table_privilege('authenticated', v_tbl, 'INSERT')
       or not has_table_privilege('authenticated', v_tbl, 'UPDATE') then
      raise exception 'VERIFY: authenticated is missing INSERT or UPDATE on %', v_tbl;
    end if;
  end if;
end $$;

commit;
